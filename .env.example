# Binance
BINANCE_API_KEY=
BINANCE_SECRET=
USE_TESTNET=true
LIVE_TRADING_REVIEWED=false
TESTNET_TRADE_COUNT=0

# Venue: "spot" or "futures".
#   spot    -> long-only. SHORT signals are rejected by the gate because a spot
#              account has nothing to sell (this is what caused the endless
#              -2010 rejection loop on BNB/ETH/SOL).
#   futures -> both directions. Requires a futures API key + testnet.
MARKET_TYPE=spot
TAKER_FEE_RATE=0.001

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://botuser:strongpassword@localhost:5432/crypto_bot
POSTGRES_DB=crypto_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=strongpassword

# Trading universe
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,ADAUSDT
TIMEFRAMES=1m,5m,15m,1h,4h,1d
PRIMARY_TIMEFRAME=1h
ENTRY_ON_CLOSED_CANDLE=true

# Risk controls
MAX_RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS_PCT=4
MAX_WEEKLY_LOSS_PCT=8
MAX_CONCURRENT_TRADES=8
CONFIDENCE_THRESHOLD=0.45
MAX_PORTFOLIO_RISK_PCT=6
MAX_POSITION_PCT=5
DRAWDOWN_CIRCUIT_BREAKER_PCT=15
CIRCUIT_BREAKER_RESET_PCT=5

# Conviction-scaled position sizing. Risk per trade moves along this band with
# how strong the setup is, instead of every trade staking the same fraction.
RISK_MIN_PCT=0.25
RISK_MAX_PCT=1.25
RISK_CURVE_GAMMA=1.5

# Signal quality gates
LSTM_MIN_MARGIN=0.15
MIN_MODEL_QUALITY=0.40
MIN_CONFLUENCE_SCORE=60
MIN_INDICATOR_AGREEMENT=4
MIN_CONVICTION=0.20
RL_VETO_CONFIDENCE=0.55

# Exits: scale out, lock profit, cut a reversing winner
STOP_ATR_MULTIPLE=1.5
LABEL_HORIZON=12
TP1_R_MULTIPLE=1.0
TP2_R_MULTIPLE=2.0
FINAL_TARGET_R_MULTIPLE=4.0
SCALE_OUT_TP1_FRACTION=0.40
SCALE_OUT_TP2_FRACTION=0.30
PROFIT_LOCK_ARM_R=0.25
PROFIT_LOCK_GIVE_BACK=0.50
TRAIL_ARM_R=1.0
TRAIL_ATR_MULTIPLE=2.5
REVERSAL_EXIT_ENABLED=true
REVERSAL_EXIT_MIN_R=0.15
TIME_STOP_HOURS=8
LOSS_COOLDOWN_BARS=2

# Training / learning
#   mainnet -> pull historical klines from api.binance.com public endpoint
#              (no key needed). Use this on testnet: the testnet keeps only a
#              few weeks of its own synthetic prices, far too little to train on.
#   venue   -> pull from whatever USE_TESTNET points at.
TRAINING_DATA_SOURCE=mainnet
TRAINING_DAYS=730
TRAINING_INTERVAL=1h
LEARNING_INTERVAL_MINUTES=360
MIN_RETRAIN_ROWS=1500
MIN_RL_UPDATE_ROWS=500

# Optional public data APIs
CRYPTOCOMPARE_API_KEY=
ECONOMIC_CALENDAR_API_URL=
REQUIRE_ECONOMIC_CALENDAR=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
