# Binance
BINANCE_API_KEY=
BINANCE_SECRET=
USE_TESTNET=true
LIVE_TRADING_REVIEWED=false
TESTNET_TRADE_COUNT=0

# PostgreSQL
DATABASE_URL=
POSTGRES_DB=crypto_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=

# Trading universe
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,ADAUSDT
TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Risk controls
MAX_RISK_PER_TRADE_PCT=2.5
MAX_DAILY_LOSS_PCT=15
MAX_WEEKLY_LOSS_PCT=25
MAX_CONCURRENT_TRADES=1
CONFIDENCE_THRESHOLD=0.33
MAX_PORTFOLIO_RISK_PCT=4.5
DRAWDOWN_CIRCUIT_BREAKER_PCT=60

# Optional public data APIs
CRYPTOCOMPARE_API_KEY=
ECONOMIC_CALENDAR_API_URL=
REQUIRE_ECONOMIC_CALENDAR=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# LAB_MODE removed: the gate no longer has a bypass mode
MAX_POSITION_PCT=25
MARKET_TYPE=spot
TRAINING_DATA_SOURCE=mainnet
TAKER_FEE_RATE=0.001
RISK_MIN_PCT=1.5
RISK_MAX_PCT=2.5
RISK_CURVE_GAMMA=1.5
CIRCUIT_BREAKER_RESET_PCT=8
FORCE_TRADING_PAUSED=0
PEAK_GUARD_ARM_R=0.5
PEAK_GUARD_GIVEBACK_PCT=5
BREAKEVEN_ARM_R=0.2
MIN_CONVICTION=0.12
BREAKEVEN_ENABLED=false
MIN_LIVE_TRADES=60
MAX_LOSS_R=1.5
PROFIT_FLOOR_ENABLED=false
PROFIT_FLOOR_ARM_R=0.3
PROFIT_FLOOR_R=0.05

# ===== LIVE / FUTURES scaffolding (keep commented for DEMO) =====
# To go LIVE on real futures, fill these + flip the three flags below, then restart:
#   1) BINANCE_FUTURES_API_KEY / SECRET  (real-account key, Futures permission, NO withdrawals, IP-whitelisted)=
#   2) MARKET_TYPE=futures   3) USE_TESTNET=false   4) LIVE_TRADING_REVIEWED=true
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_SECRET=
DISABLED_STRATEGIES=SHORT_MOMENTUM_TREND
PURE_TP_SL=true
FINAL_TARGET_R_MULTIPLE=4.0
MIN_REWARD_RISK=3.0
STOP_MIN_PCT=2.0
